Panels:
- Class: rviz/Displays
  Name: Displays
- Class: rviz/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 35; 38; 45
  Displays:
  - Class: rviz/Grid
    Name: Ground grid
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 30
  - Class: rviz/RobotModel
    Name: ugv1
    Enabled: true
    Robot Description: /ugv1/robot_description
    TF Prefix: ugv1
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
  - Class: rviz/Path
    Name: ugv1 path
    Enabled: true
    Topic: /ugv1/history_path
    Color: 230; 80; 60
    Line Width: 0.02
    Buffer Length: 1
  - Class: rviz/Marker
    Name: ugv1 label
    Enabled: true
    Marker Topic: /ugv1/marker_name
  - Class: rviz/RobotModel
    Name: uav1
    Enabled: true
    Robot Description: /uav1/robot_description
    TF Prefix: uav1
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
